#!/usr/bin/env python3
"""Draw random integers between 1 and MAX without replacement."""
import argparse
import random
import sys


def main():
    parser = argparse.ArgumentParser(
        description="Draw random integers between 1 and MAX without replacement."
    )
    parser.add_argument("max", type=int, help="upper bound (inclusive)")
    parser.add_argument(
        "-n", "--draws", type=int, default=1, help="number of draws (default: 1)"
    )
    parser.add_argument(
        "-r", "--runs", type=int, default=1,
        help="number of runs, one line each (default: 1)",
    )
    parser.add_argument(
        "-s", "--sort", action="store_true",
        help="sort output lines numerically",
    )
    args = parser.parse_args()

    if args.max < 1:
        parser.error("max must be >= 1")
    if args.draws < 1:
        parser.error("number of draws must be >= 1")
    if args.draws > args.max:
        parser.error(
            f"cannot draw {args.draws} numbers without replacement from 1..{args.max}"
        )
    if args.runs < 1:
        parser.error("number of runs must be >= 1")

    runs = [
        sorted(random.sample(range(1, args.max + 1), args.draws))
        for _ in range(args.runs)
    ]
    if args.sort:
        runs.sort()
    for run in runs:
        print(" ".join(map(str, run)))


if __name__ == "__main__":
    main()
