# Machine-specific environment variables.
# Sourced by both bash and zsh. Keep secrets and per-machine config here.
# This file is symlinked to ~/.localrc — do not commit secrets.
# Copy to localrc.symlink and fill in values for your machine.

# =============================================
# Agent-safe variables (exposed to AI agents)
# Every agent sets AI_AGENT to its own name: Claude Code its own identifier,
# "codex" and "opencode" from the wrappers in aliases/aliases.symlink.
# Anything in this section stays visible to them -- put credentials the agent
# tools themselves need to run here, not below.
# =============================================

# --- GitHub ---
# Personal access token (fine-grained or classic)
# Generate at: https://github.com/settings/tokens
# export GH_TOKEN=""
# export GITHUB_PAT=""        # used by Claude Code MCP github plugin
# export GH_USER=""           # org/repo for default operations

# --- Context7 (Claude Code plugin) ---
# The context7 MCP server reads CONTEXT7_API_KEY straight from the environment;
# it must be exported before launching Claude Code. Do NOT set it in
# claude/settings.json -- values in its "env" block are literal strings, so a
# "${VAR}" there is passed through unexpanded.
# Optional: without a key the plugin connects anonymously on shared rate limits.
# Get one at: https://context7.com/dashboard
# export CONTEXT7_API_KEY=""


# --- OpenRouter (opencode) ---
# Read by opencode/opencode.jsonc as {env:OR_OPENCODE_API_KEY}.
# Must stay agent-safe: opencode runs with AI_AGENT set and cannot authenticate
# without it. Separate from OR_API_KEY, which claude-op uses.
# Get one at: https://openrouter.ai/keys
# export OR_OPENCODE_API_KEY=""

# =============================================
# Restricted variables (hidden from AI agents)
# Skipped whenever AI_AGENT is set to anything non-empty.
# =============================================
# Any non-empty AI_AGENT means an agent is driving this shell. Each tool sets its
# own name -- Claude Code its own identifier, "codex" and "opencode" from the
# wrappers in aliases/aliases.symlink -- so test for "set at all", never for one
# specific value. Set AI_AGENT=0 to force the human path.
if [ -z "$AI_AGENT" ] || [ "$AI_AGENT" = "0" ]; then

    # --- Pushover (push notifications) ---
    # Create app + get keys at: https://pushover.net/apps/build
    # export PUSHOVER_API_TOKEN=""
    # export PUSHOVER_USER_KEY=""

    # --- Slack ---
    # Incoming webhook URL suffix (after hooks.slack.com/services/)
    # Create at: https://api.slack.com/messaging/webhooks
    # export NOTIFICATION_HOOK=""

    # --- Google Gemini ---
    # API key from: https://aistudio.google.com/apikey
    # export GEMINI_API_KEY=""

    # --- AWS ---
    # ECR account ID for docker login
    # export AWS_ACCOUNT=""

    # --- Anthropic ---
    # export ANTHROPIC_API_KEY=""

    :  # placeholder — remove when you uncomment exports above
fi
